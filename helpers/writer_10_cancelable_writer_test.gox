package helpers

import (
	"runtime"
	"testing"
	"time"
)

func TestCancelableWriter(t *testing.T) {
	blockingWriter := NewBlockingWriter(0)

	writer := NewCancelableWriter(blockingWriter, 100*time.Millisecond)

	chDone := make(chan struct{})

	go func() {
		bytesWritten, errWrite := writer.Write([]byte("test data"))

		t.Logf("Write returned: n=%d, err=%v", bytesWritten, errWrite)

		close(chDone)
	}()

	select {
	case <-chDone:
		t.Log(
			"Writer returned!")

	case <-time.After(2 * time.Second):
		t.Fatal(
			"Write is still blocked after 2 seconds.",
		)
	}
}

// This test does not detect a memory *leak* in the GC sense.
// It detects allocation *churn* caused by CancelableWriter creating a new
// io.Pipe for every Write call. Each pipe allocates internal buffers and
// goroutine stacks, and even though all goroutines exit and memory becomes
// unreachable, TotalAlloc only ever increases.
//
// With a blocking underlying writer, every Write hits the timeout path,
// causing 1000 pipes to be created. The GC frees them, but TotalAlloc grows,
// making pipe usage visible as "accumulation" in allocation statistics.
//
// This test ensures we are aware of the cost of per-Write pipe creation.
// It does NOT indicate goroutine leakage or retained memory.
func TestCancelableWriter_PipeLeak(t *testing.T) {
	blockingWriter := NewBlockingWriter(0)

	writer := NewCancelableWriter(blockingWriter, 10*time.Millisecond)

	var memBefore, memAfter runtime.MemStats

	runtime.GC()
	runtime.ReadMemStats(&memBefore)

	// Perform many writes that timeout
	for range 1000 {
		writer.Write(
			[]byte(
				"test data that is somewhat long to make pipe allocation visible",
			),
		)
	}

	runtime.GC()
	runtime.ReadMemStats(&memAfter)

	// Each write creates a new pipe (which uses buffers internally)
	allocIncrease := memAfter.TotalAlloc - memBefore.TotalAlloc
	if allocIncrease > 10*1024*1024 { // More than 10MB allocation for 1000 writes
		t.Errorf(
			"Suspicious memory allocation: %d Mb for 1000 writes (pipe accumulation)",
			allocIncrease/(1024*1024),
		)
	}
}

func TestCancelableWriter_NoLeak(t *testing.T) {
	blockingWriter := NewBlockingWriter(0)
	writer := NewCancelableWriter(blockingWriter, 10*time.Millisecond)

	// Baseline goroutine count
	baseGoroutines := runtime.NumGoroutine()

	// Baseline heap objects
	var before, after runtime.MemStats
	runtime.GC()
	runtime.ReadMemStats(&before)

	for i := 0; i < 2000; i++ {
		_, _ = writer.Write([]byte("some payload that triggers timeout"))
	}

	// Force cleanup
	runtime.GC()
	runtime.ReadMemStats(&after)

	// Check goroutine stability
	goroutinesNow := runtime.NumGoroutine()
	if goroutinesNow > baseGoroutines+5 {
		t.Fatalf("goroutine leak: before=%d after=%d", baseGoroutines, goroutinesNow)
	}

	// Check heap object stability (not HeapAlloc!)
	objectsIncrease := after.HeapObjects - before.HeapObjects
	if objectsIncrease > 2000 {
		t.Fatalf("heap object leak: grew by %d objects", objectsIncrease)
	}
}
